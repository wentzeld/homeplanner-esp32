BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//Example//Rules//EN
BEGIN:VEVENT
UID:second-tuesday@rules.example
DTSTART:20260908T020000Z
DTEND:20260908T030000Z
RRULE:FREQ=MONTHLY;BYDAY=2TU
SUMMARY:PTA (2nd Tuesday)
END:VEVENT
BEGIN:VEVENT
UID:last-friday@rules.example
DTSTART;VALUE=DATE:20260925
RRULE:FREQ=MONTHLY;BYDAY=-1FR
SUMMARY:Pizza Friday
END:VEVENT
BEGIN:VEVENT
UID:last-day@rules.example
DTSTART;VALUE=DATE:20260930
RRULE:FREQ=MONTHLY;BYMONTHDAY=-1
SUMMARY:Month end
END:VEVENT
BEGIN:VEVENT
UID:last-weekday@rules.example
DTSTART;VALUE=DATE:20260930
RRULE:FREQ=MONTHLY;BYDAY=MO,TU,WE,TH,FR;BYSETPOS=-1
SUMMARY:Last weekday
END:VEVENT
BEGIN:VEVENT
UID:first-weekday@rules.example
DTSTART;VALUE=DATE:20260901
RRULE:FREQ=MONTHLY;BYDAY=MO,TU,WE,TH,FR;BYSETPOS=1;COUNT=8
SUMMARY:First weekday
END:VEVENT
BEGIN:VEVENT
UID:the-31st@rules.example
DTSTART:20260831T160000Z
DTEND:20260831T170000Z
RRULE:FREQ=MONTHLY;BYMONTHDAY=31
SUMMARY:On the 31st
END:VEVENT
BEGIN:VEVENT
UID:plain-monthly@rules.example
DTSTART:20260131T160000Z
DTEND:20260131T170000Z
RRULE:FREQ=MONTHLY
SUMMARY:Monthly from Jan 31
END:VEVENT
BEGIN:VEVENT
UID:every-3-days@rules.example
DTSTART:20260901T140000Z
DTEND:20260901T150000Z
RRULE:FREQ=DAILY;INTERVAL=3;COUNT=20
SUMMARY:Every third day
END:VEVENT
BEGIN:VEVENT
UID:weekdays-daily@rules.example
DTSTART:20261005T130000Z
DTEND:20261005T133000Z
RRULE:FREQ=DAILY;BYDAY=MO,TU,WE,TH,FR;UNTIL=20261016
SUMMARY:Daily on weekdays until a date
END:VEVENT
BEGIN:VEVENT
UID:birthday@rules.example
DTSTART;VALUE=DATE:20100314
RRULE:FREQ=YEARLY
SUMMARY:Birthday
END:VEVENT
BEGIN:VEVENT
UID:leap@rules.example
DTSTART;VALUE=DATE:20240229
RRULE:FREQ=YEARLY
SUMMARY:Leap day
END:VEVENT
BEGIN:VEVENT
UID:thanksgiving@rules.example
DTSTART;VALUE=DATE:20201126
RRULE:FREQ=YEARLY;BYMONTH=11;BYDAY=4TH
SUMMARY:Thanksgiving
END:VEVENT
BEGIN:VEVENT
UID:summer-weekly@rules.example
DTSTART:20260601T160000Z
DTEND:20260601T170000Z
RRULE:FREQ=WEEKLY;BYMONTH=6,7,8,12
SUMMARY:Weekly in some months
END:VEVENT
BEGIN:VEVENT
UID:yearly-multi@rules.example
DTSTART;VALUE=DATE:20260101
RRULE:FREQ=YEARLY;BYMONTH=1,10,12;BYMONTHDAY=1,15
SUMMARY:1st and 15th of some months
END:VEVENT
BEGIN:VEVENT
UID:allday-exdate@rules.example
DTSTART;VALUE=DATE:20261012
RRULE:FREQ=DAILY;COUNT=10
EXDATE;VALUE=DATE:20261014,20261016
SUMMARY:Camp week
END:VEVENT
BEGIN:VEVENT
UID:unsupported@rules.example
DTSTART:20260907T160000Z
DTEND:20260907T170000Z
RRULE:FREQ=YEARLY;BYWEEKNO=37,40
SUMMARY:Unsupported rule (first only)
END:VEVENT
BEGIN:VEVENT
UID:monthly-interval@rules.example
DTSTART:20260115T170000Z
DTEND:20260115T180000Z
RRULE:FREQ=MONTHLY;INTERVAL=2;BYDAY=3TH
SUMMARY:Every other month 3rd Thursday
END:VEVENT
BEGIN:VEVENT
UID:long-ago-daily@rules.example
DTSTART:20150101T080000Z
DTEND:20150101T081500Z
RRULE:FREQ=DAILY
EXDATE:20261003T080000Z
SUMMARY:Daily since 2015
END:VEVENT
END:VCALENDAR
