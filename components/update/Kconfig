menu "HomePlanner: software updates"

    config HP_UPDATE_REPO
        string "GitHub repository with the releases (owner/name)"
        default "wentzeld/homeplanner-esp32"

    config HP_OTA_TEST_NEVER_GOOD
        bool "Test build: never confirm itself (to test automatic rollback)"
        default n
        help
            Only for testing: this firmware never marks itself as working, so 5 minutes after an
            update the panel goes back to the previous version. Never release a build with this on.

    config HP_UPDATE_TEST_SCREEN_ON
        bool "Test build: keep the screen on while an update is written"
        default n
        help
            Only for testing flash auto-suspend: normally the screen is turned off while an update is
            written, because the flash writes make it flicker. Never release a build with this on.

endmenu
